      "types": "./dist/statistics/median/index.d.ts",
      "import": "./dist/statistics/median/index.js"
    },
    "./compare": {
      "types": "./dist/compare/index.d.ts",
      "import": "./dist/compare/index.js"
    },
    "./convert/centimeters-to-meters": {
