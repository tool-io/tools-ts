{
  "name": "@tool.io/tools",
  "version": "0.1.0",
  "private": false,
  "description": "Framework-independent TypeScript tools for tool.io",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "catalog.generated.json",
    "contracts.generated.json",
    "tool-contract.schema.json",
    "portable-value.schema.json",
    "table-data.schema.json",
    "tabular-presentation.schema.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    },
    "./catalog": "./catalog.generated.json",
    "./chain": {
      "types": "./dist/chain/index.d.ts",
      "import": "./dist/chain/index.js"
    },
    "./contracts": "./contracts.generated.json",
    "./contracts/schema": "./tool-contract.schema.json",
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./dictionary": {
      "types": "./dist/dictionary/index.d.ts",
      "import": "./dist/dictionary/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery.d.ts",
      "import": "./dist/discovery.js"
    },
    "./flashcards": {
      "types": "./dist/flashcards/index.d.ts",
      "import": "./dist/flashcards/index.js"
    },
    "./parse/numeric-dataset": {
      "types": "./dist/parse/numeric-dataset/index.d.ts",
      "import": "./dist/parse/numeric-dataset/index.js"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./schemas/portable-value": "./portable-value.schema.json",
    "./schemas/table-data": "./table-data.schema.json",
    "./schemas/tabular-presentation": "./tabular-presentation.schema.json",
    "./statistics/median": {
      "types": "./dist/statistics/median/index.d.ts",
      "import": "./dist/statistics/median/index.js"
    },
    "./weather": {
      "types": "./dist/weather/index.d.ts",
      "import": "./dist/weather/index.js"
    },
    "./word-relations": {
      "types": "./dist/word-relations/index.d.ts",
      "import": "./dist/word-relations/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/generate-structure.mjs && tsc -p tsconfig.build.json && node ../../scripts/generate-catalog.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "check:generated": "node ../../scripts/generate-structure.mjs --check && tsc -p tsconfig.build.json && node ../../scripts/generate-catalog.mjs --check",
    "check:release": "node ../../scripts/validate-release-package.mjs",
    "generate": "node ../../scripts/generate-structure.mjs",
    "test:unit": "vitest run",
    "unittest": "vitest run",
    "validate": "pnpm build && node ../../scripts/validate-package.mjs"
  },
  "dependencies": {
    "ts-fsrs": "5.4.1"
  }
}
