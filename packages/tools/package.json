{
  "name": "@toolio/tools",
  "version": "0.1.0",
  "private": false,
  "description": "Framework-independent TypeScript tools for tool.io",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
