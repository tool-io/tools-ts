{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": false
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/__tests__/**",
    "src/**/*-testing.ts",
    "src/**/*-test-support.ts",
    "src/**/*-spec-support.ts",
    "src/**/*-spec.ts"
  ]
}
