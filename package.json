{
  "name": "tools-ts-workspace",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "pnpm --filter @tool.io/tools build",
    "check": "pnpm --filter @tool.io/tools check",
    "check:contribution": "node scripts/validate-contributions.mjs",
    "check:generated": "node --test scripts/implementation-dates.test.mjs scripts/contract-schema-validation.test.mjs scripts/portable-schema-validation.test.mjs scripts/tabular-schema-validation.test.mjs && pnpm --filter @tool.io/tools check:generated",
    "check:release": "pnpm --filter @tool.io/tools check:release",
    "generate": "pnpm --filter @tool.io/tools generate",
    "test:unit": "pnpm --filter @tool.io/tools test:unit",
    "unittest": "pnpm --filter @tool.io/tools unittest",
    "validate": "pnpm --filter @tool.io/tools validate"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "8.1.6",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@<3.1.8": "3.1.9",
      "source-map-js@<1.2.2": "1.2.2"
    }
  }
}
