{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool.io/contracts/dictionary-chunk.schema.json",
  "title": "Tool.io dictionary chunk",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "datasetId",
    "datasetVersion",
    "sourceLanguage",
    "targetLanguage",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "toolio.dictionary-chunk"
    },
    "formatVersion": {
      "const": 1
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceLanguage": {
      "type": "string",
      "minLength": 2
    },
    "targetLanguage": {
      "type": "string",
      "minLength": 2
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "licenseUrl",
        "sourceTitle",
        "sourceUrl"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1
        },
        "licenseUrl": {
          "type": "string",
          "format": "uri"
        },
        "sourceTitle": {
          "type": "string",
          "minLength": 1
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "translation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "text"
      ],
      "properties": {
        "language": {
          "type": "string",
          "minLength": 2
        },
        "qualifier": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "type": "string",
          "minLength": 1
        },
        "romanization": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "headword",
        "normalizedHeadword",
        "language",
        "partOfSpeech",
        "translations",
        "attribution"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "headword": {
          "type": "string",
          "minLength": 1
        },
        "normalizedHeadword": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "partOfSpeech": {
          "type": "string",
          "minLength": 1
        },
        "translations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/translation"
          }
        },
        "attribution": {
          "$ref": "#/$defs/attribution"
        }
      }
    }
  }
}
