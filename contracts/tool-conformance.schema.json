{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tool.io/contracts/tool-conformance.schema.json",
  "title": "Tool.io tool conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractVersion"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "contractVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "input", "expected"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "input": {},
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ok", "output"],
                "properties": {
                  "ok": { "const": true },
                  "output": {},
                  "absoluteTolerance": { "type": "number", "minimum": 0 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["ok", "errorCode"],
                "properties": {
                  "ok": { "const": false },
                  "errorCode": { "type": "string", "minLength": 1 },
                  "issueCodes": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
